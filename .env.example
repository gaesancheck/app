# Kakao native app key; also used by the Kakao Maps native SDK.
NATIVE_APP_KEY=

# Naver native login SDK credentials.
NAVER_CID=
NAVER_CLIENT_SECRET=

# Google Cloud OAuth client credentials (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple web OAuth credentials for the backend only. Client secret is a signed JWT.
# Never expose these via EXPO_PUBLIC_* or app.config.ts extra.
APPLE_CLIENT_ID=kr.pro203s.pawstep.signin
APPLE_CLIENT_SECRET=

# Public HTTPS origin for Google callback; register the callback path in Google Cloud.
# The deployed API handles regular requests and social OAuth callbacks.
PUBLIC_BASE_URL=https://pawstep-api.pro203s.kr
EXPO_PUBLIC_API_BASE_URL=https://pawstep-api.pro203s.kr

# Optional development server settings.
AUTH_PORT=3000
JWT_SECRET=replace-with-a-random-local-development-secret

# Use the deployed backend on physical devices and in production builds.
EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_ENABLE_DEV_AUTH=false
